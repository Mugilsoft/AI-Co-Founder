# Mugil AI Co-Founder Environment Credentials
# Copy this file to .env in your project root to auto-load your credentials

# Gemini API Key (Required for live lead search & LLM responses)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model (Default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Google Application Credentials (Optional for Google Sheets sync)
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json
